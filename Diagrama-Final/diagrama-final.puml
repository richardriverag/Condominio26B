@startuml
top to bottom direction
skinparam shadowing false
skinparam packageStyle rectangle

skinparam linetype ortho
skinparam nodesep 14
skinparam ranksep 28
skinparam padding 6
skinparam RoundCorner 8

skinparam usecase {
  BackgroundColor #F4F9FF
  BorderColor #2B5B84
  FontSize 10
  ArrowColor #4A5568
}

skinparam actor {
  BackgroundColor #FFFBEB
  BorderColor #B45309
  FontColor #1F2937
  FontSize 10
}

skinparam package {
  BackgroundColor #F9FAFB
  BorderColor #6B7280
  FontStyle bold
  FontSize 11
}

title Condominio26B - Arquitectura General de Casos de Uso

' =========================================================
' FILA SUPERIOR: JERARQUÍA DE ROLES CENTRADA ARRIBA
' =========================================================
package "Jerarquía de Roles del Sistema" as P_ROLES {
  actor "Usuario" as U_Base
  actor "Residente" as R_Base
  actor "Propietario" as P_Base
  actor "Guardia" as G_Base
  actor "Mantenimiento" as M_Base
  actor "Trabajador" as T_Base
  actor "Administrador" as A_Base

  R_Base -up-|> U_Base
  P_Base -up-|> U_Base
  G_Base -up-|> U_Base
  M_Base -up-|> U_Base
  T_Base -up-|> U_Base
  A_Base -up-|> U_Base
}

' =========================================================
' FILA MEDIA: 3 MÓDULOS ALINEADOS (GRB | GRE | GRD)
' =========================================================
together {
  package "GRB - Usuarios y Acceso" as P_GRB {
    actor "Usuario" as U_GRB
    actor "Admin" as A_GRB

    usecase "GRB-CU01\nAutenticarse" as GRB1
    usecase "GRB-CU03\nConsultar perfil,\nrol y emergencia" as GRB3
    usecase "GRB-CU02\nGestionar usuarios\ny roles" as GRB2

    U_GRB --> GRB1
    U_GRB --> GRB3
    A_GRB --> GRB2
  }

  package "GRE - Check-in" as P_GRE {
    actor "Guardia" as G_GRE
    actor "Residente" as R_GRE
    actor "Admin" as A_GRE

    usecase "GRE-CU01\nRegistrar entrada\nde visitante" as GRE1
    usecase "GRE-CU02\nAsociar visitante\na residente/inmueble" as GRE2
    usecase "GRE-CU07\nAsignar parqueadero\nde visita" as GRE7
    usecase "GRE-CU03\nProgramar llegada" as GRE3
    usecase "GRE-CU04\nNotificar llegada\nprogramada" as GRE4
    usecase "GRE-CU05\nVer historial\nde llegadas" as GRE5
    usecase "GRE-CU06\nAlerta rápida\nemergencia/simulacro" as GRE6
    usecase "GRE-CU08\nConfigurar límite\nde parqueaderos" as GRE8

    G_GRE --> GRE1
    G_GRE --> GRE5
    G_GRE --> GRE6
    G_GRE --> GRE7

    R_GRE --> GRE3
    R_GRE --> GRE5

    A_GRE --> GRE5
    A_GRE --> GRE6
    A_GRE --> GRE8

    GRE1 ..> GRE2 : <<include>>
    GRE1 ..> GRE7 : <<include>>
    GRE3 ..> GRE4 : <<include>>
  }

  package "GRD - Reservas" as P_GRD {
    actor "Residente" as R_GRD
    actor "Admin" as A_GRD

    usecase "GRD-CU02\nSolicitar reserva\nárea común" as GRD2
    usecase "GRD-CU03\nCancelar reserva" as GRD3
    usecase "GRD-CU04\nGestionar\ndisponibilidad" as GRD4
    usecase "GRD-CU05\nAprobar/rechazar\nreserva" as GRD5
    usecase "GRD-CU01\nVer disponibilidad" as GRD1

    R_GRD --> GRD1
    R_GRD --> GRD2
    R_GRD --> GRD3

    A_GRD --> GRD3
    A_GRD --> GRD4
    A_GRD --> GRD5

    GRD2 ..> GRD1 : <<include>>
    GRD4 ..> GRD1 : <<include>>
  }
}

' =========================================================
' FILA INFERIOR: 3 MÓDULOS ALINEADOS (GRA | GRC | GRF)
' =========================================================
together {
  package "GRA - Pagos y Finanzas" as P_GRA {
    actor "Residente" as R_GRA
    actor "Banco" as B_GRA

    usecase "GRA-CU01\nRegistrar\npago" as GRA1
    usecase "GRA-CU02\nConsultar estado\ny deuda" as GRA2
    usecase "GRA-CU03\nActualizar estado\nde cuenta" as GRA3
    usecase "GRA-CU04\nProcesar pago\nelectrónico" as GRA4

    R_GRA --> GRA1
    R_GRA --> GRA2
    B_GRA --> GRA4

    GRA1 ..> GRA3 : <<include>>
    GRA1 ..> GRA4 : <<include>>
  }

  package "GRC - Inmuebles" as P_GRC {
    actor "Residente" as R_GRC
    actor "Propietario" as P_GRC_Act
    actor "Mantenimiento" as M_GRC
    actor "Admin" as A_GRC

    usecase "GRC-CU01\nGestionar\ninmuebles" as GRC1
    usecase "GRC-CU02\nGestionar\ncatálogo" as GRC2
    usecase "GRC-CU03\nGestionar\npropiedad" as GRC3
    usecase "GRC-CU04\nConsultar inmuebles\ny catálogo" as GRC4
    usecase "GRC-CU05\nReservar/agendar\ninmueble" as GRC5
    usecase "GRC-CU06\nCancelar/reprogramar\nagenda" as GRC6
    usecase "GRC-CU07\nRegistrar evento\no reparación" as GRC7
    usecase "GRC-CU08\nGenerar reporte\nde cambios" as GRC8
    usecase "GRC-CU13\nRegistrar pago\nde reserva" as GRC13
    usecase "GRC-CU09\nConsultar\ndisponibilidad" as GRC9
    usecase "GRC-CU10\nGestionar avisos\ny recordatorios" as GRC10

    R_GRC --> GRC4
    R_GRC --> GRC5
    R_GRC --> GRC6

    P_GRC_Act --> GRC3
    P_GRC_Act --> GRC4
    P_GRC_Act --> GRC5
    P_GRC_Act --> GRC6

    M_GRC --> GRC7

    A_GRC --> GRC1
    A_GRC --> GRC2
    A_GRC --> GRC3
    A_GRC --> GRC7
    A_GRC --> GRC8

    GRC5 ..> GRC9 : <<include>>
    GRC6 ..> GRC9 : <<include>>
    GRC5 ..> GRC10 : <<include>>
    GRC6 ..> GRC10 : <<include>>
    GRC7 ..> GRC10 : <<include>>
  }

  package "GRF - Comunicación" as P_GRF {
    actor "Usuario" as U_GRF
    actor "Admin" as A_GRF

    usecase "GRF-CU01\nMensaje a\nresidentes" as GRF1
    usecase "GRF-CU02\nComunicado a\ntrabajadores" as GRF2
    usecase "GRF-CU03\nMensaje\nglobal" as GRF3
    usecase "GRF-CU04\nMensaje\ndirecto" as GRF4
    usecase "GRF-CU05\nCrear\nreporte" as GRF5
    usecase "GRF-CU09\nAdjuntar\nevidencia" as GRF9
    usecase "GRF-CU06\nModificar anuncio\ngeneral" as GRF6
    usecase "GRF-CU07\nEliminar anuncio\ngeneral" as GRF7
    usecase "GRF-CU08\nNotificar a\ndestinatarios" as GRF8

    U_GRF --> GRF4
    U_GRF --> GRF5

    A_GRF --> GRF1
    A_GRF --> GRF2
    A_GRF --> GRF3
    A_GRF --> GRF6
    A_GRF --> GRF7

    GRF1 ..> GRF8 : <<include>>
    GRF2 ..> GRF8 : <<include>>
    GRF3 ..> GRF8 : <<include>>
    GRF4 ..> GRF8 : <<include>>
    GRF5 <.. GRF9 : <<extend>>
  }
}

' Anclas centrales limpias (arriba -> fila 1 -> fila 2)
P_ROLES -[hidden]down-> P_GRE
P_GRE -[hidden]down-> P_GRC

@enduml